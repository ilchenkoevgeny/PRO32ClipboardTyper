<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildProjectDirectory)\Assets\fallback.ico</ApplicationIcon>
    <AssemblyName>PRO32ClipboardTyper</AssemblyName>
    <RootNamespace>PRO32ClipboardTyper</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TrayApplicationContext.cs" />
    <Compile Include="HotKeyWindow.cs" />
    <Compile Include="NativeMethods.cs" />
    <Compile Include="ClipboardService.cs" />
    <Compile Include="PRO32WindowService.cs" />
    <Compile Include="PRO32ProcessService.cs" />
    <Compile Include="CdpInputService.cs" />
  </ItemGroup>

  <!-- The checked-in fallback icon keeps clean builds independent of PRO32. -->
  <Target Name="ExtractPro32ApplicationIcon"
          BeforeTargets="CoreCompile"
          Condition="'$(OS)' == 'Windows_NT' And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\extract-pro32-icon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Assets\pro32.ico&quot;"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_Pro32IconExitCode" />
    </Exec>

    <PropertyGroup>
      <ApplicationIcon Condition="'$(_Pro32IconExitCode)' == '0' And Exists('$(MSBuildProjectDirectory)\Assets\pro32.ico')">$(MSBuildProjectDirectory)\Assets\pro32.ico</ApplicationIcon>
    </PropertyGroup>

    <Message Condition="'$(_Pro32IconExitCode)' != '0'"
             Text="PRO32 icon unavailable; using the bundled fallback icon."
             Importance="high" />
  </Target>
</Project>
